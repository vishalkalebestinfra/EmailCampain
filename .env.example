PORT=3000

# Shown in email templates and the From header display name
COMPANY_NAME="BestInfra Pvt Ltd"
COMPANY_WEBSITE=https://www.bestinfra.org
COMPANY_EMAIL=marketrelations@bestinfra.tech
COMPANY_PHONE="+91 9440409776"

# Zoho Mail SMTP — use the full mailbox as SMTP_USER
# Custom-domain / Workplace (India): smtppro.zoho.in
# Free personal India: smtp.zoho.in  |  Global: smtp.zoho.com  |  EU: smtp.zoho.eu
# Port 465 + SMTP_SECURE=true (SSL)  or  587 + SMTP_SECURE=false (STARTTLS)
# If 2FA is on, use a Zoho Application-Specific Password
SMTP_HOST=smtppro.zoho.in
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info@bestinfra.tech
# Prefer single quotes when the password contains $ @ # or spaces
SMTP_PASS='your-zoho-password'
SMTP_FROM_NAME=BestInfra Pvt Ltd
SMTP_FROM_EMAIL=info@bestinfra.tech
SMTP_FROM="BestInfra Pvt Ltd <info@bestinfra.tech>"
SMTP_TIMEOUT_MS=120000

# Pause between emails to avoid provider rate limits (ms)
SEND_DELAY_MS=800

# PostgreSQL connection string for sends, opens, and unsubscribes
DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/emailer

# Public HTTPS URL recipients use for open tracking, Explore clicks, and unsubscribe links.
# localhost works for Explore/Unsubscribe from your own browser, but Gmail cannot load open pixels from localhost.
PUBLIC_BASE_URL=http://localhost:3000

# General thank-you template (Template/ThankyouEmail.html) — Explore More CTA
BOOKING_URL=https://www.bestinfra.org/
